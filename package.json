{
  "name": "dsh-rwkv-plugin",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "description": "RWKV-7 G1 continuation models as a DeepSeek Harness LLM provider, with the RWKV-Agent harness (agent-wire XML, parser repairs, duplicate/closeout policy) ported in.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke.ts",
    "state": "node scripts/state.ts",
    "headless": "node scripts/headless.ts"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-alpha.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "exports": {
    ".": "./lib/index.js",
    "./line-edit": "./lib/line-edit.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
